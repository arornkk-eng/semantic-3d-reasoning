{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object.schema.json",
  "title": "Semantic object",
  "type": "object",
  "required": ["object_id", "category", "semantic_confidence", "gaussian_indices"],
  "properties": {
    "object_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "semantic_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "gaussian_indices": {
      "type": "object",
      "required": ["source_index", "file", "encoding", "count"],
      "properties": {
        "source_index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string", "minLength": 1 },
        "encoding": { "const": "uint32-le" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "semantic_embedding_file": { "type": ["string", "null"] },
    "region_id": { "type": ["string", "null"] },
    "observations": { "type": "array", "items": { "type": "object" }, "default": [] }
  },
  "additionalProperties": true
}
